<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Marty's Money Tracker</title>
  <style>
    :root {
      --bg: #fff9f4;
      --bg-soft: #fff3ea;
      --card: rgba(255, 255, 255, 0.9);
      --text: #5b4636;
      --muted: #9a7f6b;
      --line: #f1dccd;
      --accent: #f4a261;
      --accent-2: #ffd7b8;
      --green: #7bbf9a;
      --green-soft: #e7f5ec;
      --red: #e8897d;
      --red-soft: #ffe7e3;
      --blue: #8fb8de;
      --blue-soft: #eaf3fb;
      --yellow: #f2c94c;
      --yellow-soft: #fff4cf;
      --shadow: 0 12px 32px rgba(176, 126, 88, 0.12);
      --radius-xl: 26px;
      --radius-lg: 20px;
      --radius-md: 14px;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: "Avenir Next", "Segoe UI", Arial, sans-serif;
      color: var(--text);
      background:
        radial-gradient(circle at top left, #fff1e4 0, transparent 28%),
        radial-gradient(circle at top right, #ffe9dd 0, transparent 25%),
        linear-gradient(180deg, #fffaf6 0%, #fff7f0 100%);
      min-height: 100vh;
    }

    body::before {
      content: "🐾  🐾  🐾";
      position: fixed;
      right: 18px;
      bottom: 18px;
      opacity: 0.12;
      font-size: 28px;
      pointer-events: none;
      letter-spacing: 10px;
    }

    .container {
      max-width: 1180px;
      margin: 0 auto;
      padding: 24px 18px 48px;
    }

    .hero {
      display: grid;
      grid-template-columns: 1.25fr 0.95fr;
      gap: 18px;
      margin-bottom: 20px;
    }

    .hero-card,
    .marty-card,
    .card {
      background: var(--card);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,0.75);
      box-shadow: var(--shadow);
      border-radius: var(--radius-xl);
    }

    .hero-card {
      padding: 28px;
      position: relative;
      overflow: hidden;
      background: linear-gradient(135deg, #fffaf6 0%, #fff1e7 100%);
    }

    .hero-card::after {
      content: "";
      position: absolute;
      width: 200px;
      height: 200px;
      background: radial-gradient(circle, #ffe0cc 0%, transparent 70%);
      right: -50px;
      top: -40px;
      border-radius: 50%;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #fff2e6;
      color: #b86c2f;
      border: 1px solid #ffd8bc;
      border-radius: 999px;
      padding: 8px 12px;
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 14px;
      position: relative;
      z-index: 1;
    }

    .hero h1 {
      margin: 0;
      font-size: clamp(28px, 4vw, 42px);
      line-height: 1.06;
      letter-spacing: -0.02em;
      position: relative;
      z-index: 1;
    }

    .hero p {
      margin: 12px 0 0;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.6;
      max-width: 640px;
      position: relative;
      z-index: 1;
    }

    .marty-card {
      padding: 22px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 230px;
      background: linear-gradient(135deg, #fff7f2 0%, #ffe7d7 100%);
      position: relative;
      overflow: hidden;
    }

    .marty-card::after {
      content: "🐾";
      position: absolute;
      right: 18px;
      bottom: 16px;
      font-size: 42px;
      opacity: 0.12;
    }

    .marty-top {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .marty-avatar {
      width: 88px;
      height: 88px;
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 8px 20px rgba(0,0,0,0.14);
      flex-shrink: 0;
      border: 4px solid rgba(255,255,255,0.75);
      background: #fff;
    }

    .marty-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .marty-name-row {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 4px;
    }

    .marty-name {
      font-size: 21px;
      font-weight: 800;
    }

    .marty-mood {
      font-size: 24px;
      line-height: 1;
      transition: transform 0.2s ease;
    }

    .marty-card:hover .marty-mood {
      transform: scale(1.08);
    }

    .marty-note {
      color: var(--muted);
      font-size: 14px;
      line-height: 1.5;
    }

    .marty-footer {
      margin-top: 16px;
      padding: 14px 16px;
      border-radius: 16px;
      background: rgba(255,255,255,0.55);
      border: 1px dashed #ffd6b6;
      color: #9e6943;
      font-size: 14px;
      line-height: 1.5;
    }

    .grid {
      display: grid;
      gap: 18px;
    }

    .grid-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-bottom: 18px;
    }

    .grid-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-bottom: 18px;
    }

    .card {
      padding: 22px;
      background: rgba(255,255,255,0.92);
    }

    .summary-card {
      position: relative;
      overflow: hidden;
    }

    .summary-card::before {
      content: "";
      position: absolute;
      right: -15px;
      bottom: -18px;
      width: 90px;
      height: 90px;
      border-radius: 50%;
      background: rgba(255,255,255,0.45);
    }

    .summary-label {
      font-size: 14px;
      color: var(--muted);
      font-weight: 700;
      margin-bottom: 8px;
      position: relative;
      z-index: 1;
    }

    .summary-value {
      font-size: 30px;
      font-weight: 800;
      letter-spacing: -0.03em;
      margin: 0;
      position: relative;
      z-index: 1;
    }

    .income-card {
      background: linear-gradient(180deg, #f5fff9 0%, #ebfaf2 100%);
      border: 1px solid #d7efe0;
    }

    .expense-card {
      background: linear-gradient(180deg, #fff8f7 0%, #fff0ee 100%);
      border: 1px solid #ffdcd7;
    }

    .balance-card {
      background: linear-gradient(180deg, #f7fbff 0%, #edf6fe 100%);
      border: 1px solid #dceaf9;
    }

    .income {
      color: #4d9d78;
    }

    .expense {
      color: #d76f66;
    }

    .balance {
      color: #6594c4;
    }

    h2, h3 {
      margin-top: 0;
      margin-bottom: 14px;
      letter-spacing: -0.02em;
    }

    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
    }

    .section-sub {
      color: var(--muted);
      font-size: 13px;
    }

    label {
      display: block;
      margin-bottom: 7px;
      font-size: 13px;
      font-weight: 800;
      color: #8b6c57;
    }

    input, select, button {
      width: 100%;
      border-radius: 14px;
      font-size: 14px;
      transition: 0.2s ease;
    }

    input, select {
      padding: 13px 14px;
      border: 1px solid var(--line);
      background: #fffdfa;
      color: var(--text);
      outline: none;
      margin-bottom: 14px;
    }

    input:focus, select:focus {
      border-color: #f3b17b;
      box-shadow: 0 0 0 4px rgba(244, 162, 97, 0.14);
    }

    button {
      border: none;
      padding: 13px 16px;
      font-weight: 800;
      cursor: pointer;
      box-shadow: 0 8px 18px rgba(244, 162, 97, 0.18);
    }

    .primary-btn {
      background: linear-gradient(180deg, #f6ad6e 0%, #f29b58 100%);
      color: white;
    }

    .primary-btn:hover {
      transform: translateY(-1px);
      filter: brightness(0.98);
    }

    .soft-btn {
      background: #fff0e2;
      color: #ae6c3b;
      box-shadow: none;
      border: 1px solid #ffd9bb;
    }

    .soft-btn:hover {
      background: #ffe8d3;
    }

    .danger-btn {
      background: linear-gradient(180deg, #ee978b 0%, #e37f72 100%);
      color: white;
    }

    hr {
      border: none;
      border-top: 1px solid #f2e1d3;
      margin: 16px 0 18px;
    }

    .progress-card {
      background: linear-gradient(180deg, #fffefc 0%, #fff8f3 100%);
    }

    .progress-bar {
      width: 100%;
      height: 14px;
      background: #f7e8dc;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 8px;
    }

    .progress-fill {
      height: 100%;
      width: 0%;
      border-radius: 999px;
      transition: width 0.35s ease;
    }

    .saving-fill {
      background: linear-gradient(90deg, #8dd0ab 0%, #68b38d 100%);
    }

    .debt-fill {
      background: linear-gradient(90deg, #ffd27c 0%, #f1b85a 100%);
    }

    .progress-foot {
      display: flex;
      justify-content: space-between;
      font-size: 13px;
      color: var(--muted);
    }

    .transaction-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .transaction-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 14px;
      padding: 15px;
      background: #fffaf7;
      border: 1px solid #f3dfd0;
      border-radius: 18px;
    }

    .transaction-left {
      flex: 1;
      min-width: 0;
    }

    .transaction-title {
      font-weight: 800;
      margin-bottom: 5px;
      word-break: break-word;
    }

    .transaction-meta {
      color: var(--muted);
      font-size: 13px;
      line-height: 1.45;
      word-break: break-word;
    }

    .transaction-right {
      text-align: right;
      min-width: 130px;
    }

    .transaction-amount {
      font-weight: 900;
      font-size: 18px;
      margin-bottom: 8px;
    }

    .transaction-actions {
      display: flex;
      gap: 8px;
      justify-content: flex-end;
      flex-wrap: wrap;
    }

    .pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 72px;
      padding: 6px 10px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 800;
    }

    .pill-income {
      background: var(--green-soft);
      color: #4c926f;
    }

    .pill-expense {
      background: var(--red-soft);
      color: #c56d63;
    }

    .mini-delete {
      width: auto;
      margin: 0;
      padding: 8px 12px;
      border-radius: 12px;
      background: #ffe1dc;
      color: #b45f56;
      box-shadow: none;
      border: 1px solid #ffd0ca;
    }

    .mini-delete:hover {
      background: #ffd6cf;
    }

    .empty-state {
      text-align: center;
      color: var(--muted);
      padding: 26px 10px;
      border: 1px dashed #f1d8c6;
      border-radius: 18px;
      background: #fffaf7;
      line-height: 1.7;
    }

    .cute-tip {
      margin-top: 14px;
      padding: 12px 14px;
      border-radius: 14px;
      background: #fff6ef;
      border: 1px dashed #f5d1b3;
      color: #9f7454;
      font-size: 13px;
      line-height: 1.6;
    }

    .footer-note {
      text-align: center;
      color: var(--muted);
      font-size: 12px;
      margin-top: 18px;
    }

    @media (max-width: 900px) {
      .hero,
      .grid-3,
      .grid-2 {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .container {
        padding: 16px 14px 34px;
      }

      .hero-card,
      .marty-card,
      .card {
        border-radius: 20px;
      }

      .transaction-item {
        flex-direction: column;
        align-items: flex-start;
      }

      .transaction-right {
        width: 100%;
        min-width: 0;
        text-align: left;
      }

      .transaction-actions {
        justify-content: flex-start;
      }

      .summary-value {
        font-size: 26px;
      }

      .marty-top {
        align-items: flex-start;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <section class="hero">
      <div class="hero-card">
        <div class="badge">🐱 Marty theme • Personal finance tracker</div>
        <h1>Marty’s Money Tracker</h1>
        <p>
          Track your income, expenses, savings goal, and debt payoff progress
          in one cozy dashboard with Marty supervising every financial decision.
        </p>
      </div>

      <div class="marty-card">
        <div class="marty-top">
          <div class="marty-avatar">
            <img src="marty.jpg" alt="Marty" />
          </div>
          <div>
            <div class="marty-name-row">
              <div class="marty-name">Marty</div>
              <div class="marty-mood" id="martyMood">😺</div>
            </div>
            <div class="marty-note" id="martySubtext">
              Budget cat mode activated.
            </div>
          </div>
        </div>

        <div class="marty-footer" id="martyMessage">
          🐾 Marty says: “Every little saving counts.”
        </div>
      </div>
    </section>

    <div class="grid grid-3">
      <div class="card summary-card income-card">
        <div class="summary-label">Total Income</div>
        <p class="summary-value income" id="totalIncome">$0.00</p>
      </div>

      <div class="card summary-card expense-card">
        <div class="summary-label">Total Expenses</div>
        <p class="summary-value expense" id="totalExpense">$0.00</p>
      </div>

      <div class="card summary-card balance-card">
        <div class="summary-label">Current Balance</div>
        <p class="summary-value balance" id="currentBalance">$0.00</p>
      </div>
    </div>

    <div class="grid grid-2">
      <div class="card">
        <div class="section-head">
          <h2>Add Transaction</h2>
          <span class="section-sub">Log money in or out</span>
        </div>

        <label for="type">Type</label>
        <select id="type">
          <option value="income">Income</option>
          <option value="expense">Expense</option>
        </select>

        <label for="category">Category</label>
        <input id="category" type="text" placeholder="e.g. Salary, Rent, Grocery" />

        <label for="description">Description</label>
        <input id="description" type="text" placeholder="Optional note" />

        <label for="amount">Amount</label>
        <input id="amount" type="number" step="0.01" placeholder="0.00" />

        <label for="date">Date</label>
        <input id="date" type="date" />

        <button class="primary-btn" id="addTransactionBtn">Add Transaction</button>

        <div class="cute-tip">
          🐾 Tip: clear categories make your transaction list much easier to scan.
        </div>
      </div>

      <div class="card">
        <div class="section-head">
          <h2>Goals</h2>
          <span class="section-sub">Savings + debt payoff</span>
        </div>

        <label for="savingGoal">Savings Goal</label>
        <input id="savingGoal" type="number" step="0.01" placeholder="e.g. 10000" />

        <label for="currentSavings">Current Savings</label>
        <input id="currentSavings" type="number" step="0.01" placeholder="e.g. 2500" />

        <button class="soft-btn" id="saveSavingsGoalBtn">Save Savings Goal</button>

        <hr />

        <label for="debtGoal">Debt Payoff Goal</label>
        <input id="debtGoal" type="number" step="0.01" placeholder="e.g. 8000" />

        <label for="debtPaid">Amount Paid Off</label>
        <input id="debtPaid" type="number" step="0.01" placeholder="e.g. 1200" />

        <button class="soft-btn" id="saveDebtGoalBtn">Save Debt Goal</button>
      </div>
    </div>

    <div class="grid grid-2">
      <div class="card progress-card">
        <div class="section-head">
          <h2>Savings Progress</h2>
          <span class="section-sub" id="savingText">$0 of $0</span>
        </div>

        <div class="progress-bar">
          <div class="progress-fill saving-fill" id="savingProgressFill"></div>
        </div>

        <div class="progress-foot">
          <span>Start</span>
          <span id="savingPercent">0%</span>
        </div>
      </div>

      <div class="card progress-card">
        <div class="section-head">
          <h2>Debt Payoff Progress</h2>
          <span class="section-sub" id="debtText">$0 of $0</span>
        </div>

        <div class="progress-bar">
          <div class="progress-fill debt-fill" id="debtProgressFill"></div>
        </div>

        <div class="progress-foot">
          <span>Start</span>
          <span id="debtPercent">0%</span>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="section-head">
        <h2>Transactions</h2>
        <button class="danger-btn" id="clearAllBtn" style="width:auto; margin:0; padding:10px 16px;">
          Clear All
        </button>
      </div>

      <div id="transactionList" class="transaction-list"></div>
    </div>

    <div class="footer-note">
      Made for cozy budgeting sessions with Marty energy ✨
    </div>
  </div>

  <script>
    const STORAGE_KEY = "personal_finance_tracker_data";

    const defaultData = {
      transactions: [],
      savingsGoal: 0,
      currentSavings: 0,
      debtGoal: 0,
      debtPaid: 0
    };

    let appData = loadData();

    function loadData() {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return { ...defaultData };

      try {
        const parsed = JSON.parse(raw);
        return {
          ...defaultData,
          ...parsed,
          transactions: Array.isArray(parsed.transactions) ? parsed.transactions : []
        };
      } catch (error) {
        return { ...defaultData };
      }
    }

    function saveData() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(appData));
    }

    function formatCurrency(value) {
      return new Intl.NumberFormat("en-US", {
        style: "currency",
        currency: "USD"
      }).format(Number(value || 0));
    }

    function getTotals() {
      const totalIncome = appData.transactions
        .filter(item => item.type === "income")
        .reduce((sum, item) => sum + Number(item.amount), 0);

      const totalExpense = appData.transactions
        .filter(item => item.type === "expense")
        .reduce((sum, item) => sum + Number(item.amount), 0);

      return {
        totalIncome,
        totalExpense,
        balance: totalIncome - totalExpense
      };
    }

    function calculatePercent(current, goal) {
      if (!goal || goal <= 0) return 0;
      return Math.min((current / goal) * 100, 100);
    }

    function renderSummary() {
      const { totalIncome, totalExpense, balance } = getTotals();
      document.getElementById("totalIncome").textContent = formatCurrency(totalIncome);
      document.getElementById("totalExpense").textContent = formatCurrency(totalExpense);
      document.getElementById("currentBalance").textContent = formatCurrency(balance);
    }

    function renderGoals() {
      const savingsPercent = calculatePercent(appData.currentSavings, appData.savingsGoal);
      const debtPercent = calculatePercent(appData.debtPaid, appData.debtGoal);

      document.getElementById("savingGoal").value = appData.savingsGoal || "";
      document.getElementById("currentSavings").value = appData.currentSavings || "";
      document.getElementById("debtGoal").value = appData.debtGoal || "";
      document.getElementById("debtPaid").value = appData.debtPaid || "";

      document.getElementById("savingProgressFill").style.width = `${savingsPercent}%`;
      document.getElementById("debtProgressFill").style.width = `${debtPercent}%`;

      document.getElementById("savingPercent").textContent = `${savingsPercent.toFixed(1)}%`;
      document.getElementById("debtPercent").textContent = `${debtPercent.toFixed(1)}%`;

      document.getElementById("savingText").textContent =
        `${formatCurrency(appData.currentSavings)} of ${formatCurrency(appData.savingsGoal)}`;

      document.getElementById("debtText").textContent =
        `${formatCurrency(appData.debtPaid)} of ${formatCurrency(appData.debtGoal)}`;
    }

    function renderTransactions() {
      const list = document.getElementById("transactionList");
      list.innerHTML = "";

      if (!appData.transactions.length) {
        list.innerHTML = `
          <div class="empty-state">
            No transactions yet.<br />
            Marty is waiting for the first budget entry 🐾
          </div>
        `;
        return;
      }

      const sortedTransactions = [...appData.transactions].sort((a, b) => {
        return new Date(b.date) - new Date(a.date);
      });

      sortedTransactions.forEach((item) => {
        const div = document.createElement("div");
        div.className = "transaction-item";

        div.innerHTML = `
          <div class="transaction-left">
            <div class="transaction-title">${escapeHtml(item.category || "Untitled")}</div>
            <div class="transaction-meta">
              ${escapeHtml(item.description || "No description")} • ${escapeHtml(item.date || "")}
            </div>
          </div>
          <div class="transaction-right">
            <div class="transaction-amount ${item.type === "income" ? "income" : "expense"}">
              ${item.type === "income" ? "+" : "-"}${formatCurrency(item.amount)}
            </div>
            <div class="transaction-actions">
              <span class="pill ${item.type === "income" ? "pill-income" : "pill-expense"}">
                ${item.type}
              </span>
              <button onclick="deleteTransaction('${item.id}')" class="mini-delete">
                Delete
              </button>
            </div>
          </div>
        `;

        list.appendChild(div);
      });
    }

    function renderMartyMood() {
      const { totalIncome, totalExpense, balance } = getTotals();
      const savingsPercent = calculatePercent(appData.currentSavings, appData.savingsGoal);
      const debtPercent = calculatePercent(appData.debtPaid, appData.debtGoal);
      const moodEl = document.getElementById("martyMood");
      const subtextEl = document.getElementById("martySubtext");
      const messageEl = document.getElementById("martyMessage");
      const transactionCount = appData.transactions.length;

      let mood = "😺";
      let subtext = "Budget cat mode activated.";
      let message = "🐾 Marty says: “Every little saving counts.”";

      if (transactionCount === 0) {
        mood = "😴";
        subtext = "Quiet day. No budget moves yet.";
        message = "🐾 Marty says: “Start with one tiny entry. That still counts.”";
      } else if (savingsPercent >= 80) {
        mood = "😻";
        subtext = "Savings progress looks amazing.";
        message = "🐾 Marty says: “Look at you saving like a legend.”";
      } else if (debtPercent >= 80) {
        mood = "🥹";
        subtext = "Debt payoff is almost there.";
        message = "🐾 Marty says: “You’re so close. Keep going.”";
      } else if (balance >= 0 && totalIncome > totalExpense) {
        mood = "😸";
        subtext = "Income is winning today.";
        message = "🐾 Marty says: “Approved. We love a healthy balance.”";
      } else if (totalExpense > totalIncome && transactionCount > 0) {
        mood = "🙀";
        subtext = "Spending is getting suspicious.";
        message = "🐾 Marty says: “Did we really need all that?”";
      } else if (balance === 0 && transactionCount > 0) {
        mood = "🧐";
        subtext = "Everything is perfectly balanced.";
        message = "🐾 Marty says: “Interesting. Very controlled. Very precise.”";
      }

      moodEl.textContent = mood;
      subtextEl.textContent = subtext;
      messageEl.textContent = message;
    }

    function escapeHtml(str) {
      return String(str)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function renderApp() {
      renderSummary();
      renderGoals();
      renderTransactions();
      renderMartyMood();
    }

    function addTransaction() {
      const type = document.getElementById("type").value;
      const category = document.getElementById("category").value.trim();
      const description = document.getElementById("description").value.trim();
      const amount = Number(document.getElementById("amount").value);
      const date = document.getElementById("date").value;

      if (!category) {
        alert("Please enter a category.");
        return;
      }

      if (!amount || amount <= 0) {
        alert("Please enter a valid amount.");
        return;
      }

      if (!date) {
        alert("Please select a date.");
        return;
      }

      const newTransaction = {
        id: crypto.randomUUID ? crypto.randomUUID() : String(Date.now()) + Math.random().toString(16).slice(2),
        type,
        category,
        description,
        amount,
        date
      };

      appData.transactions.push(newTransaction);
      saveData();
      renderApp();

      document.getElementById("category").value = "";
      document.getElementById("description").value = "";
      document.getElementById("amount").value = "";
      document.getElementById("date").value = "";
    }

    function deleteTransaction(id) {
      appData.transactions = appData.transactions.filter(item => item.id !== id);
      saveData();
      renderApp();
    }

    function saveSavingsGoal() {
      const savingsGoal = Number(document.getElementById("savingGoal").value) || 0;
      const currentSavings = Number(document.getElementById("currentSavings").value) || 0;

      appData.savingsGoal = savingsGoal;
      appData.currentSavings = currentSavings;

      saveData();
      renderApp();
      alert("Savings goal saved.");
    }

    function saveDebtGoal() {
      const debtGoal = Number(document.getElementById("debtGoal").value) || 0;
      const debtPaid = Number(document.getElementById("debtPaid").value) || 0;

      appData.debtGoal = debtGoal;
      appData.debtPaid = debtPaid;

      saveData();
      renderApp();
      alert("Debt goal saved.");
    }

    function clearAllData() {
      const confirmed = confirm("Are you sure you want to clear all data?");
      if (!confirmed) return;

      appData = { ...defaultData };
      saveData();
      renderApp();
    }

    document.getElementById("addTransactionBtn").addEventListener("click", addTransaction);
    document.getElementById("saveSavingsGoalBtn").addEventListener("click", saveSavingsGoal);
    document.getElementById("saveDebtGoalBtn").addEventListener("click", saveDebtGoal);
    document.getElementById("clearAllBtn").addEventListener("click", clearAllData);

    window.deleteTransaction = deleteTransaction;

    renderApp();
  </script>
</body>
</html>
